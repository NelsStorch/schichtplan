---
// Startseite: «Wer bist du?» mit drei Einstiegen und den wichtigsten Seiten je Rolle.
import HandHeart from '@lucide/astro/icons/hand-heart';
import ClipboardList from '@lucide/astro/icons/clipboard-list';
import Tent from '@lucide/astro/icons/tent';
import ArrowRight from '@lucide/astro/icons/arrow-right';

const locale = Astro.locals.starlightRoute.locale;
const isFr = locale === 'fr';
const isIt = locale === 'it';
const isEn = locale === 'en';

const groups = isFr
  ? [
      {
        key: 'helfer',
        icon: HandHeart,
        kicker: 'Je donne un coup de main',
        title: 'Bénévoles',
        text: 'Parents, responsables, anciens : trouver un créneau, s’inscrire, remplir son calendrier.',
        start: '/fr/helfen/eintragen/',
        moreLabel: 'Tous les guides pour Bénévoles',
        links: [
          { label: 'S’inscrire à un créneau', href: '/fr/helfen/eintragen/' },
          { label: 'Se désinscrire', href: '/fr/helfen/austragen/' },
          { label: 'Pourquoi ne puis-je pas m’inscrire ?', href: '/fr/helfen/nicht-freigeschaltet/' },
          { label: 'Mes créneaux dans le calendrier', href: '/fr/helfen/meine-schichten/' },
        ],
      },
      {
        key: 'ok',
        icon: ClipboardList,
        kicker: 'J’organise un événement',
        title: 'Comité d’organisation',
        text: 'Fête, camp, jubilé : créer des créneaux, gérer les accès, répartir les bénévoles.',
        start: '/fr/ok/rollen/',
        moreLabel: 'Tous les guides pour le Comité',
        links: [
          { label: 'Créer un événement', href: '/fr/ok/anlass-erstellen/' },
          { label: 'Planifier les créneaux et postes', href: '/fr/ok/schichten-planen/' },
          { label: 'Qui peut s’inscrire ?', href: '/fr/ok/zugang/' },
          { label: 'Bénévoles et quotas', href: '/fr/ok/helfer-pool/' },
        ],
      },
      {
        key: 'abteilung',
        icon: Tent,
        kicker: 'Je dirige l’organisation',
        title: 'Direction & Administration',
        text: 'Configurer le plan pour votre section, groupe ou association, gérer les membres et rôles.',
        start: '/fr/abteilung/anlegen/',
        moreLabel: 'Tous les guides pour la Direction',
        links: [
          { label: 'Créer une section ou association', href: '/fr/abteilung/anlegen/' },
          { label: 'Groupes, branches & base de données', href: '/fr/abteilung/stufen/' },
          { label: 'Membres et rôles', href: '/fr/abteilung/personen/' },
          { label: 'Accueil réservé aux membres', href: '/fr/abteilung/einstellungen/' },
        ],
      },
    ]
  : isIt
  ? [
      {
        key: 'helfer',
        icon: HandHeart,
        kicker: 'Do una mano',
        title: 'Volontari',
        text: 'Genitori, animatori, ex-membri: trova un turno, iscriviti, riempi il calendario.',
        start: '/it/helfen/eintragen/',
        moreLabel: 'Tutte le guide per Volontari',
        links: [
          { label: 'Iscriversi a un turno', href: '/it/helfen/eintragen/' },
          { label: 'Cancellarsi dal turno', href: '/it/helfen/austragen/' },
          { label: 'Perché non posso iscrivermi?', href: '/it/helfen/nicht-freigeschaltet/' },
          { label: 'I miei turni nel calendario', href: '/it/helfen/meine-schichten/' },
        ],
      },
      {
        key: 'ok',
        icon: ClipboardList,
        kicker: 'Organizzo un evento',
        title: 'Comitato organizzatore',
        text: 'Festa, campo, anniversario: creare turni, gestire accessi, assegnare i volontari.',
        start: '/it/ok/rollen/',
        moreLabel: 'Tutte le guide per il Comitato',
        links: [
          { label: 'Creare un evento', href: '/it/ok/anlass-erstellen/' },
          { label: 'Pianificare turni e compiti', href: '/it/ok/schichten-planen/' },
          { label: 'Chi può iscriversi?', href: '/it/ok/zugang/' },
          { label: 'Volontari e fabbisogno', href: '/it/ok/helfer-pool/' },
        ],
      },
      {
        key: 'abteilung',
        icon: Tent,
        kicker: 'Dirigo l’organizzazione',
        title: 'Direzione & Amministrazione',
        text: 'Configurare il piano turni per sezione o gruppo, gestire membri e ruoli.',
        start: '/it/abteilung/anlegen/',
        moreLabel: 'Tutte le guide per la Direzione',
        links: [
          { label: 'Creare una sezione o associazione', href: '/it/abteilung/anlegen/' },
          { label: 'Gruppi, branche e database', href: '/it/abteilung/stufen/' },
          { label: 'Membri e ruoli', href: '/it/abteilung/personen/' },
          { label: 'Home page per soli membri', href: '/it/abteilung/einstellungen/' },
        ],
      },
    ]
  : isEn
  ? [
      {
        key: 'helfer',
        icon: HandHeart,
        kicker: 'I want to help',
        title: 'Helpers & Volunteers',
        text: 'Parents, leaders, alumni: find a shift, sign up, fill your calendar.',
        start: '/en/helfen/eintragen/',
        moreLabel: 'All guides for Helpers',
        links: [
          { label: 'Sign up for a shift', href: '/en/helfen/eintragen/' },
          { label: 'Cancel shift sign-up', href: '/en/helfen/austragen/' },
          { label: 'Why can’t I sign up?', href: '/en/helfen/nicht-freigeschaltet/' },
          { label: 'My shifts in calendar', href: '/en/helfen/meine-schichten/' },
        ],
      },
      {
        key: 'ok',
        icon: ClipboardList,
        kicker: 'I plan an event',
        title: 'Organizers',
        text: 'Festival, camp, anniversary: create shifts, manage access, assign volunteers.',
        start: '/en/ok/rollen/',
        moreLabel: 'All guides for Organizers',
        links: [
          { label: 'Create an event', href: '/en/ok/anlass-erstellen/' },
          { label: 'Plan shifts and tasks', href: '/en/ok/schichten-planen/' },
          { label: 'Who can sign up?', href: '/en/ok/zugang/' },
          { label: 'Volunteer pool & quotas', href: '/en/ok/helfer-pool/' },
        ],
      },
      {
        key: 'abteilung',
        icon: Tent,
        kicker: 'I lead the organization',
        title: 'Leadership & Admin',
        text: 'Set up shift planner for department or group, manage members and roles.',
        start: '/en/abteilung/anlegen/',
        moreLabel: 'All guides for Leadership',
        links: [
          { label: 'Create department or club', href: '/en/abteilung/anlegen/' },
          { label: 'Units, groups & database', href: '/en/abteilung/stufen/' },
          { label: 'Members and roles', href: '/en/abteilung/personen/' },
          { label: 'Members-only home page', href: '/en/abteilung/einstellungen/' },
        ],
      },
    ]
  : [
      {
        key: 'helfer',
        icon: HandHeart,
        kicker: 'Ich helfe mit',
        title: 'Helfer*innen',
        text: 'Eltern, Leitende, Ehemalige: Schicht finden, eintragen, Kalender füllen.',
        start: '/helfen/eintragen/',
        moreLabel: 'Alle Anleitungen für Helfer*innen',
        links: [
          { label: 'In eine Schicht eintragen', href: '/helfen/eintragen/' },
          { label: 'Wieder austragen', href: '/helfen/austragen/' },
          { label: 'Warum kann ich mich nicht eintragen?', href: '/helfen/nicht-freigeschaltet/' },
          { label: 'Meine Schichten im Kalender', href: '/helfen/meine-schichten/' },
        ],
      },
      {
        key: 'ok',
        icon: ClipboardList,
        kicker: 'Ich plane einen Anlass',
        title: 'OK',
        text: 'Chilbi, Lager, Jubiläum: Schichten anlegen, Zugang regeln, Helfer*innen einteilen.',
        start: '/ok/rollen/',
        moreLabel: 'Alle Anleitungen für OK',
        links: [
          { label: 'Anlass erstellen', href: '/ok/anlass-erstellen/' },
          { label: 'Schichten und Arbeiten planen', href: '/ok/schichten-planen/' },
          { label: 'Wer darf sich eintragen?', href: '/ok/zugang/' },
          { label: 'Helfende und Schicht-Soll', href: '/ok/helfer-pool/' },
        ],
      },
      {
        key: 'abteilung',
        icon: Tent,
        kicker: 'Ich leite die Organisation',
        title: 'Leitung & Verwaltung',
        text: 'Schichtplan für Abteilung, Schar oder Verein einrichten, Gruppen pflegen, Rollen verteilen.',
        start: '/abteilung/anlegen/',
        moreLabel: 'Alle Anleitungen für Leitung & Verwaltung',
        links: [
          { label: 'Abteilung oder Verein anlegen', href: '/abteilung/anlegen/' },
          { label: 'Stufen, Gruppen & Datenbank', href: '/abteilung/stufen/' },
          { label: 'Personen und Rollen', href: '/abteilung/personen/' },
          { label: 'Startseite nur für Mitglieder', href: '/abteilung/einstellungen/' },
        ],
      },
    ];

const eyebrow = isFr ? 'Démarrage' : isIt ? 'Iniziare' : isEn ? 'Get Started' : 'Einstieg';
const heading = isFr ? 'Qui êtes-vous ?' : isIt ? 'Chi sei?' : isEn ? 'Who are you?' : 'Wer bist du?';
const sub = isFr
  ? 'Choisissez votre rôle. Vous pouvez naviguer à tout moment via la recherche ou la barre latérale.'
  : isIt
  ? 'Scegli il tuo ruolo. Puoi navigare in qualsiasi momento tramite la ricerca o la barra laterale.'
  : isEn
  ? 'Choose your role. You can jump to any guide via search or the sidebar at any time.'
  : 'Wähle deine Rolle. Du kannst jederzeit über die Suche oder die Seitenleiste springen.';
---

<section class="ag not-content" aria-labelledby="ag-title">
  <div class="ag-head">
    <p class="ag-eyebrow">{eyebrow}</p>
    <h2 id="ag-title">{heading}</h2>
    <p class="ag-sub">{sub}</p>
  </div>

  <div class="ag-grid">
    {
      groups.map((g, i) => {
        const Icon = g.icon;
        return (
          <article class={`ag-card ag-card--${g.key}`} style={`--i:${i}`}>
            <div class="ag-top">
              <span class="ag-icon">
                <Icon size={22} strokeWidth={1.9} aria-hidden="true" />
              </span>
              <span class="ag-kicker">{g.kicker}</span>
            </div>
            <h3>
              <a href={g.start} class="ag-title-link">
                {g.title}
              </a>
            </h3>
            <p class="ag-text">{g.text}</p>
            <ol class="ag-links">
              {g.links.map((l) => (
                <li>
                  <a href={l.href}>
                    <span>{l.label}</span>
                    <ArrowRight size={15} strokeWidth={2} aria-hidden="true" />
                  </a>
                </li>
              ))}
            </ol>
            <div class="ag-card-footer">
              <a href={g.start} class="ag-more-link">
                <span>{g.moreLabel}</span>
                <ArrowRight size={14} strokeWidth={2.2} aria-hidden="true" />
              </a>
            </div>
          </article>
        );
      })
    }
  </div>
</section>

<style>
  .ag {
    margin-top: 4rem;
  }

  .ag-eyebrow {
    font-family: var(--__sl-font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgb(var(--accent-ink));
  }

  .ag-head h2 {
    margin-top: 0.5rem;
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.4rem + 2vw, 2.75rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1;
    color: rgb(var(--fg));
  }

  .ag-sub {
    margin-top: 0.75rem;
    max-width: 36rem;
    color: rgb(var(--fg-muted));
  }

  .ag-grid {
    display: grid;
    gap: 1rem;
    margin-top: 2rem;
  }

  .ag-card {
    --tone: var(--success);
    --tone-ink: var(--success-ink);
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
    border-radius: var(--radius-card);
    border: 1px solid rgb(var(--line));
    background: rgb(var(--surface));
    overflow: hidden;
    box-shadow: var(--shadow-soft);
    animation: fade-up 0.7s var(--ease-out-expo) both;
    animation-delay: calc(var(--i) * 80ms + 150ms);
    transition:
      transform 0.45s var(--ease-out-expo),
      border-color 0.25s ease,
      box-shadow 0.45s var(--ease-out-expo);
  }

  .ag-card::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: -40% -30% auto auto;
    width: 16rem;
    height: 16rem;
    border-radius: 999px;
    background: radial-gradient(circle, rgb(var(--tone) / 0.22), transparent 65%);
    transition: transform 0.6s var(--ease-out-expo);
  }

  .ag-card:hover {
    transform: translateY(-4px);
    border-color: rgb(var(--tone) / 0.45);
    box-shadow: var(--shadow-lift);
  }

  .ag-card:hover::before {
    transform: scale(1.25);
  }

  .ag-card--ok {
    --tone: var(--ember);
    --tone-ink: var(--ember-ink);
  }

  .ag-card--abteilung {
    --tone: var(--accent);
    --tone-ink: var(--accent-ink);
  }

  .ag-title-link {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .ag-title-link:hover {
    color: rgb(var(--tone-ink));
  }

  .ag-card-footer {
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid rgb(var(--line));
  }

  .ag-more-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.8438rem;
    font-weight: 650;
    text-decoration: none;
    color: rgb(var(--tone-ink));
    transition: gap 0.2s ease;
  }

  .ag-more-link:hover {
    gap: 0.55rem;
    text-decoration: underline;
  }

  .ag-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .ag-icon {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 1rem;
    background: rgb(var(--tone) / 0.14);
    color: rgb(var(--tone-ink));
  }

  .ag-kicker {
    font-family: var(--__sl-font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgb(var(--fg-subtle));
    text-align: end;
  }

  .ag-card h3 {
    margin-top: 1.375rem;
    font-family: var(--font-display);
    font-size: 1.625rem;
    font-weight: 800;
    letter-spacing: -0.035em;
    color: rgb(var(--fg));
  }

  .ag-text {
    margin-top: 0.5rem;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: rgb(var(--fg-muted));
  }

  .ag-links {
    margin-top: 1.25rem;
    padding: 0;
    list-style: none;
    counter-reset: ag;
    border-top: 1px solid rgb(var(--line));
  }

  .ag-links li {
    counter-increment: ag;
    border-bottom: 1px solid rgb(var(--line));
  }

  .ag-links li:last-child {
    border-bottom: 0;
  }

  .ag-links a {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-block: 0.6875rem;
    font-size: 0.9063rem;
    font-weight: 600;
    text-decoration: none;
    color: rgb(var(--fg));
  }

  .ag-links a::before {
    content: counter(ag, decimal-leading-zero);
    font-family: var(--__sl-font-mono);
    font-size: 0.6875rem;
    color: rgb(var(--fg-subtle));
  }

  .ag-links a span {
    flex: 1;
  }

  .ag-links a :global(svg) {
    color: rgb(var(--fg-subtle));
    transition:
      transform 0.3s var(--ease-out-expo),
      color 0.2s ease;
  }

  .ag-links a:hover :global(svg) {
    color: rgb(var(--tone-ink));
    transform: translateX(3px);
  }

  .ag-links a:hover span {
    color: rgb(var(--tone-ink));
  }

  @media (min-width: 50rem) {
    .ag-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>

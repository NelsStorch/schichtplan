---
// Sprach-Dropdown wie in der App (packages/ui/src/i18n/LocaleMenu.tsx) statt des nativen <select>:
// Knopf mit Sprache, Liste mit Kürzel und Häkchen. Tastatur: Pfeile/Home/End wählen, Enter/Leertaste
// bestätigt, Escape schliesst. Die Wahl setzt auch den Sprach-Cookie der App (NEXT_LOCALE), damit
// Login und Schichtplan danach in derselben Sprache erscheinen.
import config from 'virtual:starlight/user-config';
import Check from '@lucide/astro/icons/check';
import ChevronDown from '@lucide/astro/icons/chevron-down';
import Languages from '@lucide/astro/icons/languages';

const locales = config.locales ?? {};

/** Dieselbe Seite in einer anderen Sprache (wie Starlights localizedUrl, ohne base-Pfad) */
function localizedPath(pathname: string, code: string): string {
  const first = pathname.split('/')[1] ?? '';
  const withoutLocale = first !== 'root' && Object.hasOwn(locales, first) ? pathname.slice(first.length + 1) || '/' : pathname;
  return code === 'root' ? withoutLocale : `/${code}${withoutLocale}`;
}

const current = Astro.locals.starlightRoute.locale ?? 'root';
const label = Astro.locals.t('languageSelect.accessibleLabel');
const options = Object.entries(locales).map(([code, locale]) => {
  const lang = (locale?.lang ?? 'de').split('-')[0];
  return {
    href: localizedPath(Astro.url.pathname, code),
    label: locale?.label ?? code,
    lang,
    code: lang.toUpperCase(),
    selected: code === current,
  };
});
const selected = options.find((o) => o.selected) ?? options[0];
// Eindeutige IDs: Die Komponente steht im Header und im Handy-Menü
const listId = `hx-lang-${Math.random().toString(36).slice(2, 8)}`;
---

{
  config.isMultilingual && selected && (
    <hx-lang-menu data-list-id={listId}>
      <button
        type="button"
        class="lm-button"
        role="combobox"
        aria-label={label}
        aria-haspopup="listbox"
        aria-expanded="false"
      >
        <Languages size={15} strokeWidth={2} aria-hidden="true" />
        <span lang={selected.lang}>{selected.label}</span>
        <span class="lm-chevron">
          <ChevronDown size={13} strokeWidth={2.2} aria-hidden="true" />
        </span>
      </button>
      <div id={listId} class="lm-list" role="listbox" aria-label={label} hidden>
        {options.map((option, index) => (
          <div
            id={`${listId}-${index}`}
            class="lm-option"
            role="option"
            tabindex="-1"
            aria-selected={option.selected ? 'true' : 'false'}
            lang={option.lang}
            data-href={option.href}
            data-lang={option.lang}
          >
            <span class="lm-code" aria-hidden="true">
              {option.code}
            </span>
            <span class="lm-label">{option.label}</span>
            {option.selected && (
              <span class="lm-check">
                <Check size={16} strokeWidth={2.2} aria-hidden="true" />
              </span>
            )}
          </div>
        ))}
      </div>
    </hx-lang-menu>
  )
}

<script>
  const COOKIE = 'NEXT_LOCALE';
  const COOKIE_MAX_AGE = 60 * 60 * 24 * 365;

  /** Sprach-Cookie wie die App: für alle Subdomains der Verbandsdomain, lokal nur für den eigenen Host */
  function writeLocaleCookie(lang: string) {
    const host = window.location.hostname.toLowerCase();
    const orgs = (window as unknown as { SCHICHTPLAN_ORGS?: Record<string, { domain: string }> }).SCHICHTPLAN_ORGS ?? {};
    const domain = Object.values(orgs)
      .map((o) => o.domain)
      .find((d) => host === d || host.endsWith(`.${d}`));
    const parts = [
      `${COOKIE}=${lang}`,
      'path=/',
      `max-age=${COOKIE_MAX_AGE}`,
      'samesite=lax',
      ...(domain ? [`domain=.${domain}`] : []),
      ...(window.location.protocol === 'https:' ? ['secure'] : []),
    ];
    // biome-ignore lint/suspicious/noDocumentCookie: Die App liest den Cookie auf dem Server
    document.cookie = parts.join('; ');
  }

  class LangMenu extends HTMLElement {
    private button!: HTMLButtonElement;
    private list!: HTMLElement;
    private options: HTMLElement[] = [];
    private active = 0;

    connectedCallback() {
      const button = this.querySelector<HTMLButtonElement>('.lm-button');
      const list = this.querySelector<HTMLElement>('.lm-list');
      if (!button || !list) return;
      this.button = button;
      this.list = list;
      this.options = Array.from(list.querySelectorAll<HTMLElement>('[role="option"]'));

      button.addEventListener('click', () => (this.isOpen() ? this.close() : this.open()));
      button.addEventListener('keydown', (e) => this.onKeyDown(e));
      this.options.forEach((option, index) => {
        option.addEventListener('click', () => this.choose(index));
        option.addEventListener('pointermove', () => this.setActive(index));
      });
      document.addEventListener('pointerdown', (e) => {
        if (this.isOpen() && !this.contains(e.target as Node)) this.close();
      });
      // Zurück-Navigation aus dem Cache: Liste geschlossen zeigen
      window.addEventListener('pageshow', () => this.close());
    }

    private isOpen() {
      return !this.list.hidden;
    }

    private selectedIndex() {
      return Math.max(
        0,
        this.options.findIndex((o) => o.getAttribute('aria-selected') === 'true')
      );
    }

    private open() {
      // Nach oben öffnen, wenn unten kein Platz ist (z. B. im Handy-Menü)
      const rect = this.button.getBoundingClientRect();
      const spaceBelow = window.innerHeight - rect.bottom;
      this.toggleAttribute('data-up', spaceBelow < 260 && rect.top > spaceBelow);
      this.list.hidden = false;
      this.button.setAttribute('aria-expanded', 'true');
      this.button.setAttribute('aria-controls', this.list.id);
      this.setActive(this.selectedIndex());
    }

    private close() {
      if (!this.list) return;
      this.list.hidden = true;
      this.button.setAttribute('aria-expanded', 'false');
      this.button.removeAttribute('aria-controls');
      this.button.removeAttribute('aria-activedescendant');
    }

    private setActive(index: number) {
      this.active = index;
      this.options.forEach((o, i) => o.toggleAttribute('data-active', i === index));
      const option = this.options[index];
      if (option) this.button.setAttribute('aria-activedescendant', option.id);
    }

    private choose(index: number) {
      const option = this.options[index];
      this.close();
      this.button.focus();
      if (!option || option.getAttribute('aria-selected') === 'true') return;
      const lang = option.dataset.lang;
      if (lang) writeLocaleCookie(lang);
      const href = option.dataset.href;
      if (href) window.location.href = `${href}${window.location.search}${window.location.hash}`;
    }

    private onKeyDown(e: KeyboardEvent) {
      const count = this.options.length;
      if (!this.isOpen()) {
        if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
          e.preventDefault();
          this.open();
        }
        return;
      }
      switch (e.key) {
        case 'ArrowDown':
          e.preventDefault();
          this.setActive((this.active + 1) % count);
          break;
        case 'ArrowUp':
          e.preventDefault();
          this.setActive((this.active - 1 + count) % count);
          break;
        case 'Home':
          e.preventDefault();
          this.setActive(0);
          break;
        case 'End':
          e.preventDefault();
          this.setActive(count - 1);
          break;
        case 'Enter':
        case ' ':
          e.preventDefault();
          this.choose(this.active);
          break;
        case 'Escape':
          e.preventDefault();
          this.close();
          break;
        case 'Tab':
          this.close();
          break;
      }
    }
  }

  if (!customElements.get('hx-lang-menu')) customElements.define('hx-lang-menu', LangMenu);
</script>

<style>
  hx-lang-menu {
    position: relative;
    display: inline-flex;
  }

  .lm-button {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    height: 2.75rem;
    padding-inline: 0.875rem 0.75rem;
    border-radius: 999px;
    border: 1px solid rgb(var(--line));
    background: rgb(var(--surface-2) / 0.7);
    color: rgb(var(--fg-muted));
    font: inherit;
    font-size: 0.8125rem;
    font-weight: 600;
    cursor: pointer;
    transition:
      color 0.2s ease,
      background-color 0.2s ease;
  }

  .lm-button:hover,
  .lm-button[aria-expanded='true'] {
    color: rgb(var(--fg));
    background: rgb(var(--surface-2));
  }

  .lm-button:focus-visible {
    outline: none;
    box-shadow: 0 0 0 2px rgb(var(--accent) / 0.5);
  }

  .lm-chevron {
    display: inline-flex;
    color: rgb(var(--fg-subtle));
    transition: transform 0.2s ease;
  }

  .lm-button[aria-expanded='true'] .lm-chevron {
    transform: rotate(180deg);
  }

  .lm-list {
    position: absolute;
    top: calc(100% + 0.5rem);
    right: 0;
    z-index: 100;
    min-width: 11rem;
    padding: 0.375rem;
    border-radius: 1rem;
    border: 1px solid rgb(var(--line));
    background: rgb(var(--surface) / 0.96);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    box-shadow: var(--shadow-lift);
    transform-origin: top right;
    animation: lm-in 0.18s var(--ease-out-expo);
  }

  .lm-list[hidden] {
    display: none;
  }

  :global(hx-lang-menu[data-up]) .lm-list {
    top: auto;
    bottom: calc(100% + 0.5rem);
    transform-origin: bottom right;
  }

  .lm-option {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.5rem 0.625rem;
    border-radius: 0.75rem;
    font-size: 0.875rem;
    color: rgb(var(--fg-muted));
    cursor: pointer;
    transition: background-color 0.15s ease;
  }

  .lm-option[data-active] {
    background: rgb(var(--surface-2));
    color: rgb(var(--fg));
  }

  .lm-option[aria-selected='true'] {
    font-weight: 600;
    color: rgb(var(--fg));
  }

  .lm-code {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 1.75rem;
    height: 1.25rem;
    border-radius: 0.375rem;
    background: rgb(var(--surface-2));
    color: rgb(var(--fg-subtle));
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .lm-option[aria-selected='true'] .lm-code {
    background: rgb(var(--accent) / 0.12);
    color: rgb(var(--accent-ink));
  }

  .lm-label {
    flex: 1;
    white-space: nowrap;
  }

  .lm-check {
    display: inline-flex;
    color: rgb(var(--accent));
  }

  @keyframes lm-in {
    from {
      opacity: 0;
      transform: scale(0.96);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lm-list,
    .lm-chevron {
      animation: none;
      transition: none;
    }
  }
</style>

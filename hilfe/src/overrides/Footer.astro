---
// Unter jeder Seite: Weiter/Zurück und ein ruhiger Kontakt-Streifen statt «Built with Starlight».
import Pagination from 'virtual:starlight/components/Pagination';
import LifeBuoy from '@lucide/astro/icons/life-buoy';
import ThumbsUp from '@lucide/astro/icons/thumbs-up';
import ThumbsDown from '@lucide/astro/icons/thumbs-down';
import UsageStats from '../components/UsageStats.astro';
import rootPkg from '../../../package.json';
import { execSync } from 'node:child_process';

let revision = process.env.APP_REVISION || '';
if (!revision) {
  try {
    revision = execSync('git rev-parse --short HEAD', { stdio: ['ignore', 'pipe', 'ignore'] }).toString().trim();
  } catch {}
}
const cleanSha = revision.replace(/-dirty-\d+$/, '').replace(/-dirty$/, '');
const isGitSha = /^[0-9a-f]{7,40}$/i.test(cleanSha);
const commitUrl = isGitSha ? `https://github.com/NelsStorch/schichtplan/commit/${cleanSha}` : 'https://github.com/NelsStorch/schichtplan';
const versionLabel = cleanSha ? `v${rootPkg.version} (${cleanSha})` : `v${rootPkg.version}`;

const isSplash = Astro.locals.starlightRoute.entry.data.template === 'splash';
const locale = Astro.locals.starlightRoute.locale;
const isFrench = locale === 'fr';
const isItalian = locale === 'it';
const isEnglish = locale === 'en';

const feedbackQuestion = isFrench
  ? 'Ce guide vous a-t-il été utile ?'
  : isItalian
    ? 'Questa guida è stata utile?'
    : isEnglish
      ? 'Was this guide helpful?'
      : 'War diese Anleitung hilfreich?';

const yesLabel = isFrench ? 'Oui' : isItalian ? 'Sì' : isEnglish ? 'Yes' : 'Ja';
const noLabel = isFrench ? 'Non' : isItalian ? 'No' : isEnglish ? 'No' : 'Nein';
const doneLabel = isFrench
  ? 'Merci pour votre retour !'
  : isItalian
    ? 'Grazie per il tuo feedback!'
    : isEnglish
      ? 'Thank you for your feedback!'
      : 'Danke für deine Rückmeldung!';

const helpTitle = isFrench
  ? 'Vous n’avez pas trouvé ce que vous cherchiez ?'
  : isItalian
    ? 'Non hai trovato quello che cercavi?'
    : isEnglish
      ? 'Didn’t find what you were looking for?'
      : 'Nicht gefunden, was du suchst?';

const contactHref = isFrench ? '/fr/wissen/kontakt/' : isItalian ? '/it/wissen/kontakt/' : isEnglish ? '/en/wissen/kontakt/' : '/wissen/kontakt/';
const privacyHref = isFrench ? 'https://cevi-schichtplan.ch/fr/protection-des-donnees' : isItalian ? 'https://cevi-schichtplan.ch/it/protezione-dei-dati' : isEnglish ? 'https://cevi-schichtplan.ch/en/privacy' : 'https://cevi-schichtplan.ch/datenschutz';
const termsHref = isFrench ? 'https://cevi-schichtplan.ch/fr/conditions-utilisation' : isItalian ? 'https://cevi-schichtplan.ch/it/condizioni-di-utilizzo' : isEnglish ? 'https://cevi-schichtplan.ch/en/terms' : 'https://cevi-schichtplan.ch/nutzungsbedingungen';
const imprintHref = isFrench ? 'https://cevi-schichtplan.ch/fr/mentions-legales' : isItalian ? 'https://cevi-schichtplan.ch/it/colophon' : isEnglish ? 'https://cevi-schichtplan.ch/en/imprint' : 'https://cevi-schichtplan.ch/impressum';
---

<footer class="ft">
  {!isSplash && <Pagination />}

  {
    !isSplash && (
      <div class="ft-feedback not-content print:hidden" data-feedback-wrap>
        <span class="ft-feedback-label">{feedbackQuestion}</span>
        <div class="ft-feedback-actions" data-feedback-actions>
          <button type="button" class="ft-feedback-btn" data-feedback-val="yes" aria-label={yesLabel}>
            <ThumbsUp size={15} strokeWidth={2.2} aria-hidden="true" />
            <span>{yesLabel}</span>
          </button>
          <button type="button" class="ft-feedback-btn" data-feedback-val="no" aria-label={noLabel}>
            <ThumbsDown size={15} strokeWidth={2.2} aria-hidden="true" />
            <span>{noLabel}</span>
          </button>
        </div>
        <p class="ft-feedback-done" data-feedback-done hidden>
          {doneLabel}
        </p>
      </div>
    )
  }

  <div class="ft-help print:hidden">
    <span class="ft-icon" aria-hidden="true"><LifeBuoy size={20} strokeWidth={1.9} /></span>
    <div class="ft-copy">
      <p class="ft-title">{helpTitle}</p>
      <p class="ft-text">
        {isFrench ? (
          <>
            Demandez d'abord au CO de votre événement ou à la direction de votre groupe/section. Les erreurs dans le plan de créneaux peuvent être signalées via <a href={contactHref}>Contact</a>.
          </>
        ) : isItalian ? (
          <>
            Chiedi prima al comitato del tuo evento o alla direzione del tuo gruppo/sezione. Gli errori nel piano possono essere segnalati tramite <a href={contactHref}>Contatto</a>.
          </>
        ) : isEnglish ? (
          <>
            First ask your event organizers or group leaders. Report bugs in the shift planner via <a href={contactHref}>Contact</a>.
          </>
        ) : (
          <>
            Frag zuerst das OK deines Anlasses oder die Leitung deiner Abteilung, Schar bzw. deines Vereins. Fehler im Schichtplan selbst meldest du
            über <a href={contactHref}>Kontakt</a>.
          </>
        )}
      </p>
    </div>
  </div>

  <div class="ft-bottom">
    <span data-footer-copyright>© {new Date().getFullYear()} Cevi Schichtplan · ehrenamtlich &amp; Open Source</span>
    <nav aria-label="Weitere Seiten des Schichtplans">
      <a href="https://cevi-schichtplan.ch" data-app-link data-footer-app-domain>cevi-schichtplan.ch</a>
      <a href="https://login.cevi-schichtplan.ch" data-footer-login-domain>Login</a>
      <a href="https://status.cevi-schichtplan.ch" data-footer-status-domain>Status</a>
      <a href={privacyHref} data-footer-privacy-domain>{isFrench ? 'Protection des données' : isItalian ? 'Protezione dei dati' : isEnglish ? 'Privacy' : 'Datenschutz'}</a>
      <a href={termsHref} data-footer-terms-domain>{isFrench ? 'Conditions d’utilisation' : isItalian ? 'Condizioni' : isEnglish ? 'Terms' : 'Nutzungsbedingungen'}</a>
      <a href={imprintHref} data-footer-imprint-domain>{isFrench ? 'Mentions légales' : isItalian ? 'Colophon' : isEnglish ? 'Imprint' : 'Impressum'}</a>
      <a href="https://github.com/NelsStorch/schichtplan" rel="noopener">GitHub</a>
      <a href={commitUrl} rel="noopener" target="_blank" class="ft-version" title={`Version ${rootPkg.version}${cleanSha ? ` (${cleanSha})` : ''} auf GitHub`}>{versionLabel}</a>
    </nav>
  </div>
  <UsageStats />
</footer>

<script>
  const wrap = document.querySelector('[data-feedback-wrap]');
  if (wrap) {
    const actions = wrap.querySelector('[data-feedback-actions]');
    const done = wrap.querySelector('[data-feedback-done]');

    wrap.querySelectorAll<HTMLButtonElement>('[data-feedback-val]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const val = btn.getAttribute('data-feedback-val');
        if (val) {
          const metric = val === 'yes' ? 'HELP_FEEDBACK_YES' : 'HELP_FEEDBACK_NO';
          fetch('/api/stats/ui', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ events: [{ name: metric, dim: location.pathname }] }),
            credentials: 'omit',
            keepalive: true,
          }).catch(() => undefined);
        }
        if (actions) actions.setAttribute('hidden', '');
        if (done) done.removeAttribute('hidden');
      });
    });
  }
</script>

<style>
  .ft {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-top: 4rem;
  }

  .ft-feedback {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.875rem 1.5rem;
    padding: 0.875rem 1.25rem;
    border-radius: 1rem;
    border: 1px solid rgb(var(--line));
    background: rgb(var(--surface));
    font-size: 0.875rem;
    box-shadow: var(--shadow-soft);
  }

  .ft-feedback-label {
    font-weight: 600;
    color: rgb(var(--fg));
  }

  .ft-feedback-actions {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .ft-feedback-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.375rem 0.875rem;
    border-radius: 999px;
    border: 1px solid rgb(var(--line-strong));
    background: rgb(var(--surface-2) / 0.6);
    color: rgb(var(--fg));
    font-size: 0.8125rem;
    font-weight: 650;
    cursor: pointer;
    transition:
      border-color 0.2s ease,
      background-color 0.2s ease,
      transform 0.15s ease;
  }

  .ft-feedback-btn:hover {
    border-color: rgb(var(--accent) / 0.5);
    background: rgb(var(--surface));
    transform: translateY(-1px);
  }

  .ft-feedback-btn:active {
    transform: translateY(0);
  }

  .ft-feedback-done {
    margin: 0;
    font-size: 0.8438rem;
    font-weight: 650;
    color: rgb(var(--success-ink));
  }

  .ft-help {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    padding: 1.25rem;
    border-radius: 1.25rem;
    border: 1px dashed rgb(var(--line-strong));
  }

  .ft-icon {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 0.875rem;
    background: rgb(var(--surface-2));
    color: rgb(var(--fg-muted));
  }

  .ft-title {
    font-family: var(--font-display);
    font-weight: 750;
    font-size: 1.0625rem;
    color: rgb(var(--fg));
  }

  .ft-text {
    margin-top: 0.25rem;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: rgb(var(--fg-muted));
  }

  .ft-text a {
    color: rgb(var(--accent-ink));
    font-weight: 600;
  }

  .ft-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    padding-block: 1.5rem 0.5rem;
    border-top: 1px solid rgb(var(--line));
    font-size: 0.8125rem;
    color: rgb(var(--fg-subtle));
  }

  .ft-bottom nav {
    display: flex;
    gap: 1.25rem;
  }

  .ft-bottom a {
    color: inherit;
    text-decoration: none;
  }

  .ft-bottom a:hover {
    color: rgb(var(--fg));
  }

  .ft-version {
    font-family: var(--font-mono, monospace);
    font-size: 0.75rem;
    opacity: 0.85;
  }
</style>
